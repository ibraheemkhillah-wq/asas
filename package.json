{
  "name": "callrent-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Call & Rent — نظام إدارة عمليات التشغيل لشركة تأجير السيارات",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --watch --no-warnings=ExperimentalWarning src/server.js",
    "seed": "node --no-warnings=ExperimentalWarning scripts/seed.js",
    "mcp": "node --no-warnings=ExperimentalWarning src/mcp/server.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "eganis:check": "node --no-warnings=ExperimentalWarning scripts/eganis-check.js",
    "eganis:inspect": "node --no-warnings=ExperimentalWarning scripts/eganis-inspect.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@modelcontextprotocol/sdk": "^1.22.0"
  }
}
