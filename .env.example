# ===== إعدادات التطبيق =====
PORT=3000
HOST=0.0.0.0
TZ=Asia/Hebron
# كلمة سر الدخول للوحة التحكم و الـ API (غيّرها فوراً)
APP_TOKEN=change-me-please
# مسار قاعدة البيانات المحلية
DB_PATH=./data/callrent.db
# السماح بأوامر التعديل (تمديد عقد، إغلاق، تغيير حالة مركبة...)
ALLOW_WRITES=true

# ===== ربط eganis =====
# mock  = بيانات تجريبية للتطوير (الافتراضي)
# api   = ربط عبر Web Service الخاص بـ eganis
# browser = تشغيل آلي للمتصفح (Playwright) عند عدم توفر API
EGANIS_DRIVER=mock
EGANIS_BASE_URL=
EGANIS_USERNAME=
EGANIS_PASSWORD=
EGANIS_API_KEY=
# bearer | basic | apikey | none
EGANIS_AUTH=bearer
# اسم ترويسة المفتاح عند استخدام apikey
EGANIS_API_KEY_HEADER=X-API-KEY
# ملف تعريف مسارات الـ API (انسخ config/eganis.example.json إلى config/eganis.json)
EGANIS_ENDPOINTS_FILE=./config/eganis.json
EGANIS_TIMEOUT_MS=20000

# ===== واتساب الشركة =====
# mock = محاكاة محلية (لا يُرسل شيء فعلياً)
# cloud = WhatsApp Cloud API من Meta
WHATSAPP_DRIVER=mock
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_VERIFY_TOKEN=callrent-verify
WA_APP_SECRET=
# false = يكتفي بصياغة الرد ويعرضه للموافقة (موصى به)
WA_AUTOSEND=false

# ===== أسعار الصرف (ليرة / دولار) =====
# live = جلب السعر تلقائياً (البنك المركزي التركي ثم مصادر احتياطية)
# manual = اعتماد سعر الشركة الثابت أدناه
FX_MODE=live
# سعر الشركة، ويُستخدم أيضاً كاحتياطي عند انقطاع الشبكة (كم ليرة للدولار)
FX_USD_TRY=
# مدة إعادة استخدام آخر سعر قبل جلب سعر جديد (بالدقائق)
FX_TTL_MINUTES=15
# الحقل المعتمد من بيانات TCMB: ForexSelling | ForexBuying | BanknoteSelling | BanknoteBuying
FX_TCMB_FIELD=ForexSelling

# ===== الذكاء الاصطناعي (صياغة الردود) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# ملف نبرة/سياسات الشركة (اختياري)
COMPANY_PROFILE_FILE=./config/company.md
