# ===== إعدادات التطبيق =====
PORT=3000
HOST=0.0.0.0
TZ=Asia/Hebron
# كلمة سر الدخول للوحة التحكم و الـ API (غيّرها فوراً)
APP_TOKEN=change-me-please
# مسار قاعدة البيانات المحلية
DB_PATH=./data/callrent.db
# السماح بأوامر التعديل (تمديد عقد، إغلاق، تغيير حالة مركبة...)
ALLOW_WRITES=true

# ===== ربط eganis =====
# mock    = بيانات تجريبية للتطوير (الافتراضي)
# api     = ربط عبر Web Service الخاص بـ eganis
# browser = دخول بحسابك العادي وقراءة صفحات اللوحة نصّاً (الموصى به —
#           خفيف ويعمل على أصغر خطة استضافة)
# browser-full = متصفّح كامل (Playwright)، للوحات تُبنى بجافاسكربت فقط.
#           يحتاج أكثر من ٥١٢ ميجا ذاكرة وإلا سقط التطبيق.
EGANIS_DRIVER=mock
EGANIS_BASE_URL=
EGANIS_USERNAME=
EGANIS_PASSWORD=
EGANIS_API_KEY=
# bearer | basic | apikey | none
EGANIS_AUTH=bearer
# اسم ترويسة المفتاح عند استخدام apikey
EGANIS_API_KEY_HEADER=X-API-KEY
# ملف تعريف مسارات الـ API (انسخ config/eganis.example.json إلى config/eganis.json)
EGANIS_ENDPOINTS_FILE=./config/eganis.json
# وضع browser: جلسة محفوظة بتسجيل دخول يدوي (npm run eganis:inspect -- login)
EGANIS_SESSION_FILE=./data/eganis-session.json
EGANIS_TIMEOUT_MS=20000
# وضع browser: مدة الاحتفاظ بنتيجة الصفحة قبل إعادة قراءتها من eganis (ثوانٍ)
EGANIS_CACHE_SECONDS=20
# مهلة انتظار الجداول التي تُحمَّل بجافاسكربت (مللي ثانية)
EGANIS_PAGE_WAIT_MS=3000
# إغلاق المتصفّح بعد خمول بهذه الدقائق — مهم على الخوادم الصغيرة (0 = لا تغلقه)
EGANIS_IDLE_CLOSE_MINUTES=10

# ===== واتساب الشركة =====
# mock = محاكاة محلية (لا يُرسل شيء فعلياً)
# cloud = WhatsApp Cloud API من Meta
WHATSAPP_DRIVER=mock
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_VERIFY_TOKEN=callrent-verify
WA_APP_SECRET=
# false = يكتفي بصياغة الرد ويعرضه للموافقة (موصى به)
WA_AUTOSEND=false

# ===== أسعار الصرف (ليرة / دولار) =====
# live = جلب السعر تلقائياً من المصادر · manual = اعتماد سعر الشركة الثابت أدناه
FX_MODE=live
# المصدر المفضّل: harem (سعر السوق — الافتراضي) | tcmb | erapi | frankfurter | custom
FX_SOURCE=harem
# سعر البيع satis (كما يظهر في تطبيق حرم) أو الشراء alis
FX_HAREM_FIELD=satis
FX_HAREM_URL=https://www.haremaltin.com/dovizapi/v1/doviz
# بعض الاستضافات يرفضها حرم ألتين، فنعيد المحاولة من داخل متصفّح الخادم
FX_HAREM_VIA_BROWSER=true
# سعر الشركة، ويُستخدم أيضاً كاحتياطي عند انقطاع الشبكة (كم ليرة للدولار)
FX_USD_TRY=
# مدة إعادة استخدام آخر سعر قبل جلب سعر جديد (بالدقائق)
FX_TTL_MINUTES=15
# تحديث تلقائي في الخلفية بنفس المدة أعلاه
FX_AUTO_REFRESH=true
# الحقل المعتمد من بيانات TCMB: ForexSelling | ForexBuying | BanknoteSelling | BanknoteBuying
FX_TCMB_FIELD=ForexSelling
# مصدر خاص بك (اختياري): أي رابط JSON ومسار الحقل داخل الاستجابة
FX_CUSTOM_URL=
FX_CUSTOM_PATH=data.USDTRY.satis
FX_CUSTOM_NAME=

# ===== الذكاء الاصطناعي (صياغة الردود) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# ملف نبرة/سياسات الشركة (اختياري)
COMPANY_PROFILE_FILE=./config/company.md
